# Containerfile — the Debian 13 environment the .deb is built in (PLAN.md §10/M6's acceptance).
#
#   podman build -f packaging/debian/Containerfile -t celeste-linux-deb .
#   mkdir -p packaging/out
#   podman run --rm -v "$PWD:/src:ro" -v "$PWD/packaging/out:/out" celeste-linux-deb \
#     /src/packaging/debian/build-package.sh /out
#
# The image is the *toolchain* and nothing else: the source is mounted read-only at run time rather
# than copied in, so a build never depends on what happened to be in a build context, and the
# checkout is never written to (`dpkg-buildpackage` works on a staged copy — see `build-package.sh`).
#
# ## Why Debian 13, and why that JDK
#
# The package has to be built on Debian because the bundled runtime and Skiko link the build host's
# glibc, so the container is the whole point rather than a convenience (PLAN.md §12).
#
# `openjdk-25-jdk-headless` is Debian 13's own JDK 25, and it covers both jobs at once: it is the
# toolchain the project compiles with (`jvmToolchain(25)` in every module) and it ships `jmods`,
# which is what `jlink` builds the packaged runtime from. That second half is not free on every
# distribution — §10/M6 records the day this machine's Gradle-provisioned Adoptium 25 turned out to
# have no `jmods` at all and the app image could not be built. `JAVA_HOME` is set so that
# `debian/rules`' smoke test uses this JDK rather than whatever `java` a PATH may hold.
#
# `zip` makes the ONNX cut and `unzip` tests it — the missing half is what let the first container
# build ship the untrimmed jar, since `unzip -l … || continue` cannot tell a missing tool from a
# trimmed jar. `debhelper` and `dpkg-dev` are the packaging; `fakeroot` is what `dpkg-buildpackage`
# reaches for on the way.
FROM debian:trixie

# `build-essential` is not decoration: `dpkg-buildpackage` refuses to start without it — measured,
# "unmet build dependencies: build-essential:native" — and `make` is what runs `debian/rules`.
#
# The `lib*-dev` packages at the end are `debian/control`'s `Build-Depends` restated, which is
# duplication with a reason: nothing reads a control file to build a container image, and
# `dpkg-checkbuilddeps` will refuse to build if any of them is missing. They are there for
# `dh_shlibdeps`, which must find every library the bundled runtime links against in order to say
# which package owns it — see the comment in `control` for the error that taught us.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      debhelper \
      dpkg-dev \
      fakeroot \
      zip \
      unzip \
      ca-certificates \
      openjdk-25-jdk-headless \
      libasound2-dev \
      libfontconfig-dev \
      libfreetype-dev \
      libgif-dev \
      libglvnd-dev \
      libharfbuzz-dev \
      libjpeg-dev \
      liblcms2-dev \
      libpng-dev \
      libx11-dev \
      libxext-dev \
      libxi-dev \
      libxrender-dev \
      libxtst-dev \
 && rm -rf /var/lib/apt/lists/*

# Debian's directory name carries the architecture — `/usr/lib/jvm/java-25-openjdk-amd64`, not the
# `/usr/lib/jvm/java-25-openjdk` that the same JDK is called on other distributions, which is what
# this said until the container was asked. Measured inside it: 69 `jmods`, the whole JDK, shipped by
# `openjdk-25-jdk-headless`.
ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
ENV PATH=/usr/lib/jvm/java-25-openjdk-amd64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /src
