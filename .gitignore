# build output
build/
*/build/
.gradle/
out/

# IDE / local machine
.idea/
*.iml
.vscode/
local.properties

# packaging output
dist/
packaging/out/

# makepkg's, when the PKGBUILD next to it builds the tree it lives in (see packaging/arch/PKGBUILD)
packaging/arch/*.pkg.tar.*
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/classes/

# OS noise
.DS_Store
*.swp

# Local harness config. Safe to commit while it holds no secret; the DeepSeek key lives in
# ~/.local/share/opencode/auth.json and must never appear here.
# opencode.json

# A real backup carries API keys, server passwords, the user's own prompts and persona artwork.
# It is never committed. A FABRICATED backup is exactly what the interop fixture needs, with invented
# values - the difference is the values, not the filename.
voice_assistant_backup*.json
